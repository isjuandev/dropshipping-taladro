---
import { configTienda, hayEspecificacionesPorConfirmar } from '../../config/tienda';
import CompatChecker from '../islas/CompatChecker';

// Contenido plegado dentro de QueIncluye: tabla técnica + verificador de compatibilidad
const specs = configTienda.producto.especificaciones;
const esDev = import.meta.env.DEV;
const hayPendientes = hayEspecificacionesPorConfirmar();

const listaSpecs = [
  { clave: 'Grosor máximo recomendado', valor: specs.grosorMaximo },
  { clave: 'Materiales compatibles', valor: specs.materiales },
  { clave: 'No apto para', valor: specs.noApto },
  { clave: 'Compatibilidad de taladro', valor: specs.compatibilidad },
  { clave: 'Medidas del accesorio', valor: specs.medidas },
  { clave: 'Peso aproximado del accesorio', valor: specs.peso },
];
// En producción solo se publican los datos ya confirmados
const specsVisibles = esDev ? listaSpecs : listaSpecs.filter((item) => item.valor !== 'POR CONFIRMAR');
---

<div class="text-white">
  {/* Aviso en desarrollo si hay especificaciones marcadas POR CONFIRMAR */}
  {esDev && hayPendientes && (
    <div class="mb-4 p-4 rounded-xl bg-yellow-950/60 border-2 border-yellow-500 text-yellow-200 text-xs">
      <div class="font-bold uppercase font-['Barlow_Condensed'] text-sm tracking-wide">
        [MODO DESARROLLO] ESPECIFICACIONES PENDIENTES DE VALIDAR
      </div>
      <p class="mt-1">
        Una o más especificaciones en <code>src/config/tienda.ts</code> están marcadas como <strong>"POR CONFIRMAR"</strong>.
        Valídalas con las medidas del lote físico antes de pasar a producción. (Este aviso solo es visible en modo desarrollo).
      </p>
    </div>
  )}

  {/* Tabla técnica en JetBrains Mono */}
  {specsVisibles.length > 0 && (
    <div class="rounded-[14px] overflow-hidden border border-gray-700/80 bg-[var(--color-hierro)] shadow-xl">
      <div class="px-4 py-3 bg-[var(--color-acero)] border-b border-gray-700 flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-300 font-['Barlow_Condensed']">
          Ficha técnica Cortadora de Lámina
        </span>
        <span class="text-[11px] text-[var(--color-chispa)] font-medium font-mono">
          SKU: {configTienda.producto.sku}
        </span>
      </div>

      <div class="divide-y divide-gray-700/60 font-mono text-xs">
        {specsVisibles.map((item) => {
          const esPendiente = item.valor === 'POR CONFIRMAR';
          return (
            <div class="grid grid-cols-1 sm:grid-cols-12 p-3.5 items-center gap-1.5">
              <div class="sm:col-span-5 text-gray-400 font-medium">{item.clave}</div>
              <div class="sm:col-span-7 font-semibold text-white">
                {esPendiente ? (
                  <span class="inline-block px-2 py-0.5 rounded bg-gray-700/80 text-yellow-300 text-xs">POR CONFIRMAR</span>
                ) : (
                  <span>{item.valor}</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  {/* Isla Preact: verificador interactivo de 2 preguntas */}
  <CompatChecker client:visible />
</div>
