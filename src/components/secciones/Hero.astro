---
import { configTienda } from '../../config/tienda';
import ImageSlide from '../ui/ImageSlide.astro';
import OrderSelector from '../islas/OrderSelector';

interface Props {
  mp4: string;
  poster: string;
  ariaLabel: string;
  titular: string;
}

const { mp4, poster, ariaLabel, titular } = Astro.props;
const producto = configTienda.producto;

const lineas = [
  { pregunta: '¿Las tijeras te cansan?', respuesta: 'Tu taladro hace la fuerza.' },
  { pregunta: '¿Cortes torcidos?', respuesta: 'La varilla de apoyo te guía.' },
  { pregunta: '¿Otra máquina?', respuesta: 'Sirve en taladros de 12-21 V.' },
];
---

<ImageSlide id="hero" video={{ mp4, poster, ariaLabel, ancho: 720, alto: 1080 }} aspecto="aspect-square" titular={titular} h1 posicionTexto="arriba">
  <div class="px-4 pt-5 pb-8 space-y-4">
    <a
      href="#resenas"
      class="group inline-flex items-center gap-2 min-h-11 -my-2 text-white no-underline"
      aria-label={`${producto.calificacion} estrellas de 5, ${producto.totalResenas} clientes. Ver reseñas`}
    >
      <div class="flex items-center text-[var(--color-chispa)]" aria-hidden="true">
        {[1, 2, 3, 4, 5].map(() => (
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
          </svg>
        ))}
      </div>
      <span class="text-sm font-bold font-mono underline-offset-4 group-hover:underline" aria-hidden="true">
        {String(producto.calificacion).replace('.', ',')} ({producto.totalResenas})
      </span>
    </a>

    <OrderSelector client:visible />

    <ul class="mt-5 mb-0 space-y-1.5 text-base text-gray-100 list-none p-0">
      {lineas.map((l) => (
        <li>
          <strong class="text-[var(--color-chispa)] font-semibold">{l.pregunta}</strong> {l.respuesta}
        </li>
      ))}
    </ul>
  </div>
</ImageSlide>
