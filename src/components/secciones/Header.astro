---
import { configTienda } from '../../config/tienda';
---

<header class="bg-[var(--color-acero)] border-b border-gray-800 py-3.5 px-4 md:px-8 sticky top-0 z-30 backdrop-blur-md bg-opacity-95">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <!-- Logo de la tienda -->
    <a
      href="/cortadora-de-lamina"
      class="flex items-center gap-2.5 group text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-naranja)] rounded-md px-1"
      aria-label="Ir a la página del producto"
    >
      <img
        src="/favicon.svg"
        alt={`Logo ${configTienda.nombreTienda}`}
        width="36"
        height="36"
        class="w-9 h-9 rounded-xl shadow-md shadow-[var(--color-naranja)]/20 group-hover:scale-105 transition-transform object-cover"
      />
      <div class="flex flex-col">
        <span class="text-xl md:text-2xl font-extrabold uppercase font-['Barlow_Condensed'] tracking-wider leading-none">
          {configTienda.nombreTienda}
        </span>
      </div>
    </a>

    <!-- Ícono / Botón directo al formulario contraentrega -->
    <a
      href="/cortadora-de-lamina#pedido"
      class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-[var(--color-hierro)] hover:bg-[var(--color-hierro)]/80 border border-gray-700 text-xs md:text-sm font-bold uppercase font-['Barlow_Condensed'] tracking-wider text-gray-200 hover:text-[var(--color-naranja)] transition-colors focus:ring-2 focus:ring-[var(--color-naranja)]"
    >
      <span class="sr-only">Hacer pedido</span>
      <svg class="w-4 h-4 text-[var(--color-naranja)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
      </svg>
    </a>
  </div>
</header>
