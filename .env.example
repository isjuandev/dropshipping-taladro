# ==============================================================================
# CONFIGURACIÓN DE CONEXIÓN CON NEXOBITE SAAS
# ==============================================================================
# Copia este archivo como .env para desarrollo local o configura estas variables
# en tu panel de despliegue (Vercel, Netlify, Cloudflare Pages).
#
# Todas las variables con prefijo PUBLIC_ están disponibles en el cliente (browser).

# Endpoint público de leads de NexoBite
PUBLIC_NEXOBITE_API_URL=https://api.nexobite.com/api/v1/public/dropshipping/campana-hexacut-pro/leads

# ID numérico del producto en Dropi/NexoBite (como string)
PUBLIC_NEXOBITE_PRODUCT_ID=98745

# Slug de la campaña activa en NexoBite
PUBLIC_NEXOBITE_CAMPAIGN_SLUG=campana-hexacut-pro
